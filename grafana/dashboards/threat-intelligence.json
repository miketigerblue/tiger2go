{
  "uid": "tigerfetch-intel",
  "title": "Threat Intelligence",
  "tags": ["tigerfetch", "intel", "provisioned"],
  "timezone": "browser",
  "refresh": "5m",
  "time": { "from": "now-7d", "to": "now" },
  "schemaVersion": 39,
  "version": 1,
  "templating": {
    "list": [
      {
        "name": "epss_threshold",
        "type": "custom",
        "current": { "text": "0.5", "value": "0.5" },
        "options": [
          { "text": "0.1", "value": "0.1", "selected": false },
          { "text": "0.3", "value": "0.3", "selected": false },
          { "text": "0.5", "value": "0.5", "selected": true },
          { "text": "0.7", "value": "0.7", "selected": false },
          { "text": "0.9", "value": "0.9", "selected": false }
        ],
        "label": "EPSS Threshold"
      },
      {
        "name": "cvss_threshold",
        "type": "custom",
        "current": { "text": "7.0", "value": "7.0" },
        "options": [
          { "text": "5.0", "value": "5.0", "selected": false },
          { "text": "7.0", "value": "7.0", "selected": true },
          { "text": "8.0", "value": "8.0", "selected": false },
          { "text": "9.0", "value": "9.0", "selected": false }
        ],
        "label": "CVSS Threshold"
      },
      {
        "name": "feed_source",
        "type": "query",
        "datasource": { "type": "postgres", "uid": "pg" },
        "query": "SELECT DISTINCT feed_url FROM current ORDER BY feed_url",
        "includeAll": true,
        "allValue": "%",
        "current": { "text": "All", "value": "$__all" },
        "multi": true,
        "sort": 1,
        "refresh": 2
      }
    ]
  },
  "panels": [

    {
      "type": "row",
      "title": "Threat Landscape Overview",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "type": "stat",
      "title": "Total CVEs Tracked",
      "gridPos": { "x": 0, "y": 1, "w": 4, "h": 4 },
      "datasource": { "type": "postgres", "uid": "pg" },
      "fieldConfig": {
        "defaults": { "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] } },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "none", "textMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "rawSql": "SELECT COUNT(*) AS total FROM cve_enriched WHERE source = 'NVD' AND vuln_status IS DISTINCT FROM 'Rejected'", "format": "table" }]
    },
    {
      "type": "stat",
      "title": "KEV Entries",
      "gridPos": { "x": 4, "y": 1, "w": 4, "h": 4 },
      "datasource": { "type": "postgres", "uid": "pg" },
      "fieldConfig": {
        "defaults": { "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }] } },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "none", "textMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "rawSql": "SELECT COUNT(*) AS kev_count FROM cve_kev WHERE withdrawn_at IS NULL", "format": "table" }]
    },
    {
      "type": "stat",
      "title": "Critical CVEs (CVSS v3/v4 >= 9)",
      "gridPos": { "x": 8, "y": 1, "w": 4, "h": 4 },
      "datasource": { "type": "postgres", "uid": "pg" },
      "fieldConfig": {
        "defaults": { "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }] } },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "none", "textMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "rawSql": "SELECT COUNT(*) AS critical FROM cve_enriched WHERE source = 'NVD' AND cvss_base >= 9.0 AND cvss_version IS DISTINCT FROM '2.0' AND vuln_status IS DISTINCT FROM 'Rejected'", "format": "table" }]
    },
    {
      "type": "stat",
      "title": "EPSS Records (Latest Day)",
      "gridPos": { "x": 12, "y": 1, "w": 4, "h": 4 },
      "datasource": { "type": "postgres", "uid": "pg" },
      "fieldConfig": {
        "defaults": { "thresholds": { "mode": "absolute", "steps": [{ "color": "purple", "value": null }] } },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "none", "textMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "rawSql": "SELECT COUNT(*) AS records FROM epss_daily WHERE as_of = (SELECT MAX(as_of) FROM epss_daily)", "format": "table" }]
    },
    {
      "type": "stat",
      "title": "High-Risk CVEs (CVSS >= $cvss_threshold AND EPSS >= $epss_threshold)",
      "gridPos": { "x": 16, "y": 1, "w": 4, "h": 4 },
      "datasource": { "type": "postgres", "uid": "pg" },
      "fieldConfig": {
        "defaults": { "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null },
          { "color": "orange", "value": 10 },
          { "color": "red", "value": 50 }
        ]}},
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "none", "textMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "rawSql": "SELECT COUNT(*) AS danger_zone FROM cve_enriched c JOIN epss_daily e ON c.cve_id = e.cve_id AND e.as_of = (SELECT MAX(as_of) FROM epss_daily) WHERE c.source = 'NVD' AND c.vuln_status IS DISTINCT FROM 'Rejected' AND c.cvss_base >= ${cvss_threshold} AND e.epss >= ${epss_threshold}", "format": "table" }]
    },
    {
      "type": "stat",
      "title": "Feed Items (7d)",
      "gridPos": { "x": 20, "y": 1, "w": 4, "h": 4 },
      "datasource": { "type": "postgres", "uid": "pg" },
      "fieldConfig": {
        "defaults": { "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "none", "textMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "rawSql": "SELECT COUNT(*) AS items FROM archive WHERE inserted_at >= NOW() - INTERVAL '7 days'", "format": "table" }]
    },

    {
      "type": "row",
      "title": "EPSS — Exploit Prediction",
      "gridPos": { "x": 0, "y": 5, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "type": "table",
      "title": "Top 25 Most Exploitable CVEs (EPSS Today)",
      "gridPos": { "x": 0, "y": 6, "w": 12, "h": 12 },
      "datasource": { "type": "postgres", "uid": "pg" },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "filterable": true } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "epss" },
            "properties": [
              { "id": "custom.displayMode", "value": "gradient-gauge" },
              { "id": "min", "value": 0 },
              { "id": "max", "value": 1 },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 0.3 },
                { "color": "orange", "value": 0.6 },
                { "color": "red", "value": 0.8 }
              ]}},
              { "id": "decimals", "value": 4 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "percentile" },
            "properties": [
              { "id": "unit", "value": "percentunit" },
              { "id": "decimals", "value": 2 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "cvss_base" },
            "properties": [
              { "id": "custom.displayMode", "value": "color-background-solid" },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 4.0 },
                { "color": "orange", "value": 7.0 },
                { "color": "red", "value": 9.0 }
              ]}},
              { "id": "decimals", "value": 1 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "in_kev" },
            "properties": [
              { "id": "custom.displayMode", "value": "color-background-solid" },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [
                { "color": "transparent", "value": null },
                { "color": "red", "value": 1 }
              ]}},
              { "id": "mappings", "value": [
                { "type": "value", "options": { "0": { "text": "", "color": "transparent" }, "1": { "text": "KEV", "color": "red" } } }
              ]}
            ]
          },
          {
            "matcher": { "id": "byName", "options": "ssvc" },
            "properties": [
              { "id": "custom.displayMode", "value": "color-background-solid" },
              { "id": "mappings", "value": [
                { "type": "value", "options": { "": { "text": "", "color": "transparent" }, "none": { "text": "", "color": "transparent" }, "poc": { "text": "PoC", "color": "orange" }, "active": { "text": "ACTIVE", "color": "red" } } }
              ]}
            ]
          }
        ]
      },
      "options": { "showHeader": true, "sortBy": [{ "displayName": "epss", "desc": true }] },
      "targets": [{
        "rawSql": "SELECT e.cve_id, e.epss, e.percentile, COALESCE(c.cvss_base, 0) AS cvss_base, COALESCE(c.cvss_version, '') AS cvss_version, COALESCE(c.ssvc_exploitation, '') AS ssvc, CASE WHEN k.cve_id IS NOT NULL THEN 1 ELSE 0 END AS in_kev FROM epss_daily e LEFT JOIN cve_enriched c ON e.cve_id = c.cve_id AND c.source = 'NVD' LEFT JOIN cve_kev k ON e.cve_id = k.cve_id AND k.withdrawn_at IS NULL WHERE e.as_of = (SELECT MAX(as_of) FROM epss_daily) AND c.vuln_status IS DISTINCT FROM 'Rejected' ORDER BY e.epss DESC LIMIT 25",
        "format": "table"
      }]
    },
    {
      "type": "table",
      "title": "EPSS Biggest Movers (24h Delta)",
      "gridPos": { "x": 12, "y": 6, "w": 12, "h": 12 },
      "datasource": { "type": "postgres", "uid": "pg" },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "filterable": true } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "delta" },
            "properties": [
              { "id": "custom.displayMode", "value": "color-text" },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 0.05 },
                { "color": "orange", "value": 0.1 },
                { "color": "red", "value": 0.2 }
              ]}},
              { "id": "decimals", "value": 4 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "epss_today" },
            "properties": [
              { "id": "custom.displayMode", "value": "gradient-gauge" },
              { "id": "min", "value": 0 },
              { "id": "max", "value": 1 },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 0.3 },
                { "color": "orange", "value": 0.6 },
                { "color": "red", "value": 0.8 }
              ]}},
              { "id": "decimals", "value": 4 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "epss_yesterday" },
            "properties": [{ "id": "decimals", "value": 4 }]
          }
        ]
      },
      "options": { "showHeader": true, "sortBy": [{ "displayName": "delta", "desc": true }] },
      "targets": [{
        "rawSql": "WITH latest AS (SELECT MAX(as_of) AS d FROM epss_daily), today AS ( SELECT cve_id, epss AS epss_today, percentile AS pct_today FROM epss_daily WHERE as_of = (SELECT d FROM latest) ), yday AS ( SELECT cve_id, epss AS epss_yesterday, percentile AS pct_yesterday FROM epss_daily WHERE as_of = (SELECT d - 1 FROM latest) ) SELECT t.cve_id, t.epss_today, y.epss_yesterday, (t.epss_today - y.epss_yesterday) AS delta, t.pct_today AS percentile_today FROM today t JOIN yday y USING (cve_id) WHERE ABS(t.epss_today - y.epss_yesterday) > 0.001 ORDER BY (t.epss_today - y.epss_yesterday) DESC LIMIT 25",
        "format": "table"
      }]
    },
    {
      "type": "bargauge",
      "title": "EPSS Score Distribution (Today)",
      "gridPos": { "x": 0, "y": 18, "w": 12, "h": 8 },
      "datasource": { "type": "postgres", "uid": "pg" },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "0-1%" }, "properties": [{ "id": "color", "value": { "fixedColor": "#73BF69", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "1-5%" }, "properties": [{ "id": "color", "value": { "fixedColor": "#96D98D", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "5-10%" }, "properties": [{ "id": "color", "value": { "fixedColor": "#FADE2A", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "10-30%" }, "properties": [{ "id": "color", "value": { "fixedColor": "#F2CC0C", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "30-50%" }, "properties": [{ "id": "color", "value": { "fixedColor": "#FF9830", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "50-70%" }, "properties": [{ "id": "color", "value": { "fixedColor": "#FF780A", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "70-90%" }, "properties": [{ "id": "color", "value": { "fixedColor": "#F2495C", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "90-100%" }, "properties": [{ "id": "color", "value": { "fixedColor": "#C4162A", "mode": "fixed" } }] }
        ]
      },
      "options": { "orientation": "horizontal", "displayMode": "gradient", "reduceOptions": { "calcs": ["lastNotNull"] }, "showUnfilled": true },
      "targets": [{
        "rawSql": "SELECT COUNT(*) FILTER (WHERE epss < 0.01) AS \"0-1%\", COUNT(*) FILTER (WHERE epss >= 0.01 AND epss < 0.05) AS \"1-5%\", COUNT(*) FILTER (WHERE epss >= 0.05 AND epss < 0.1) AS \"5-10%\", COUNT(*) FILTER (WHERE epss >= 0.1 AND epss < 0.3) AS \"10-30%\", COUNT(*) FILTER (WHERE epss >= 0.3 AND epss < 0.5) AS \"30-50%\", COUNT(*) FILTER (WHERE epss >= 0.5 AND epss < 0.7) AS \"50-70%\", COUNT(*) FILTER (WHERE epss >= 0.7 AND epss < 0.9) AS \"70-90%\", COUNT(*) FILTER (WHERE epss >= 0.9) AS \"90-100%\" FROM epss_daily WHERE as_of = (SELECT MAX(as_of) FROM epss_daily)",
        "format": "table",
        "refId": "A"
      }]
    },
    {
      "type": "stat",
      "title": "EPSS Coverage",
      "description": "Total CVEs scored today, days of historical data, and total records in the lake",
      "gridPos": { "x": 12, "y": 18, "w": 6, "h": 4 },
      "datasource": { "type": "postgres", "uid": "pg" },
      "fieldConfig": {
        "defaults": { "thresholds": { "mode": "absolute", "steps": [{ "color": "purple", "value": null }] } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "today" }, "properties": [{ "id": "displayName", "value": "CVEs Scored Today" }] },
          { "matcher": { "id": "byName", "options": "days" }, "properties": [{ "id": "displayName", "value": "Days Tracked" }, { "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "total" }, "properties": [{ "id": "displayName", "value": "Total Records" }, { "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }] }
        ]
      },
      "options": { "colorMode": "value", "graphMode": "none", "textMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{
        "rawSql": "SELECT (SELECT COUNT(*) FROM epss_daily WHERE as_of = (SELECT MAX(as_of) FROM epss_daily))::bigint AS today, COUNT(DISTINCT as_of)::bigint AS days, COUNT(*)::bigint AS total FROM epss_daily",
        "format": "table",
        "refId": "A"
      }]
    },
    {
      "type": "gauge",
      "title": "EPSS Ingest Health (Last 7 Days)",
      "description": "Days with full ingest (>320k records) out of the last 7 calendar days",
      "gridPos": { "x": 18, "y": 18, "w": 6, "h": 4 },
      "datasource": { "type": "postgres", "uid": "pg" },
      "fieldConfig": {
        "defaults": {
          "min": 0, "max": 7, "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null },
            { "color": "yellow", "value": 5 },
            { "color": "green", "value": 7 }
          ]}
        },
        "overrides": []
      },
      "options": { "showThresholdLabels": false, "showThresholdMarkers": true, "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{
        "rawSql": "SELECT COUNT(*)::bigint AS healthy_days FROM (SELECT as_of, COUNT(*) AS n FROM epss_daily WHERE as_of >= (SELECT MAX(as_of) FROM epss_daily) - INTERVAL '6 days' GROUP BY as_of HAVING COUNT(*) >= 320000) sub",
        "format": "table",
        "refId": "A"
      }]
    },
    {
      "type": "table",
      "title": "EPSS Daily Ingest Log",
      "gridPos": { "x": 12, "y": 22, "w": 12, "h": 4 },
      "datasource": { "type": "postgres", "uid": "pg" },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto" } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "records" },
            "properties": [
              { "id": "custom.displayMode", "value": "color-background-solid" },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [
                { "color": "red", "value": null },
                { "color": "orange", "value": 200000 },
                { "color": "yellow", "value": 300000 },
                { "color": "green", "value": 320000 }
              ]}}
            ]
          },
          {
            "matcher": { "id": "byName", "options": "date" },
            "properties": [{ "id": "custom.width", "value": 100 }]
          }
        ]
      },
      "options": { "showHeader": true, "sortBy": [{ "displayName": "date", "desc": true }], "footer": { "show": false } },
      "targets": [{
        "rawSql": "SELECT as_of::text AS date, COUNT(*)::bigint AS records FROM epss_daily GROUP BY as_of ORDER BY as_of DESC LIMIT 10",
        "format": "table",
        "refId": "A"
      }]
    },

    {
      "type": "row",
      "title": "Danger Zone — CVSS x EPSS",
      "gridPos": { "x": 0, "y": 26, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "type": "table",
      "title": "Danger Zone: High CVSS + High EPSS (CVSS >= $cvss_threshold AND EPSS >= $epss_threshold)",
      "description": "CVEs that are both severe AND likely to be exploited. These are priority-1 for patching.",
      "gridPos": { "x": 0, "y": 27, "w": 24, "h": 12 },
      "datasource": { "type": "postgres", "uid": "pg" },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "filterable": true } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "cvss_base" },
            "properties": [
              { "id": "custom.displayMode", "value": "color-background-solid" },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [
                { "color": "yellow", "value": null },
                { "color": "orange", "value": 8.0 },
                { "color": "red", "value": 9.0 }
              ]}},
              { "id": "decimals", "value": 1 },
              { "id": "custom.width", "value": 80 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "epss" },
            "properties": [
              { "id": "custom.displayMode", "value": "gradient-gauge" },
              { "id": "min", "value": 0 },
              { "id": "max", "value": 1 },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [
                { "color": "yellow", "value": null },
                { "color": "orange", "value": 0.7 },
                { "color": "red", "value": 0.9 }
              ]}},
              { "id": "decimals", "value": 4 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "in_kev" },
            "properties": [
              { "id": "custom.displayMode", "value": "color-background-solid" },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [
                { "color": "transparent", "value": null },
                { "color": "dark-red", "value": 1 }
              ]}},
              { "id": "mappings", "value": [
                { "type": "value", "options": { "0": { "text": "", "color": "transparent" }, "1": { "text": "ACTIVELY EXPLOITED", "color": "dark-red" } } }
              ]},
              { "id": "custom.width", "value": 180 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "ssvc" },
            "properties": [
              { "id": "custom.displayMode", "value": "color-background-solid" },
              { "id": "mappings", "value": [
                { "type": "value", "options": { "": { "text": "", "color": "transparent" }, "none": { "text": "", "color": "transparent" }, "poc": { "text": "PoC", "color": "orange" }, "active": { "text": "ACTIVE", "color": "red" } } }
              ]},
              { "id": "custom.width", "value": 80 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "risk_score" },
            "properties": [
              { "id": "custom.displayMode", "value": "gradient-gauge" },
              { "id": "min", "value": 0 },
              { "id": "max", "value": 10 },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [
                { "color": "yellow", "value": null },
                { "color": "orange", "value": 6 },
                { "color": "red", "value": 8 }
              ]}},
              { "id": "decimals", "value": 2 },
              { "id": "custom.width", "value": 200 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "percentile" },
            "properties": [
              { "id": "unit", "value": "percentunit" },
              { "id": "decimals", "value": 2 },
              { "id": "custom.width", "value": 90 }
            ]
          }
        ]
      },
      "options": { "showHeader": true, "sortBy": [{ "displayName": "risk_score", "desc": true }] },
      "targets": [{
        "rawSql": "SELECT c.cve_id, c.cvss_base, COALESCE(c.cvss_version, '') AS cvss_version, e.epss, e.percentile, ROUND((c.cvss_base * e.epss * 10)::numeric / 10, 2) AS risk_score, COALESCE(c.ssvc_exploitation, '') AS ssvc, CASE WHEN k.cve_id IS NOT NULL THEN 1 ELSE 0 END AS in_kev FROM cve_enriched c JOIN epss_daily e ON c.cve_id = e.cve_id AND e.as_of = (SELECT MAX(as_of) FROM epss_daily) LEFT JOIN cve_kev k ON c.cve_id = k.cve_id AND k.withdrawn_at IS NULL WHERE c.source = 'NVD' AND c.vuln_status IS DISTINCT FROM 'Rejected' AND c.cvss_base >= ${cvss_threshold} AND e.epss >= ${epss_threshold} ORDER BY (c.cvss_base * e.epss) DESC LIMIT 50",
        "format": "table"
      }]
    },

    {
      "type": "row",
      "title": "NVD — Vulnerability Landscape",
      "gridPos": { "x": 0, "y": 39, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "type": "barchart",
      "title": "CVSS Score Distribution",
      "description": "Grouped by the CVSS version that produced cvss_base. v2.0 has no Critical band: a v2 score of 9-10 is HIGH, not CRITICAL.",
      "gridPos": { "x": 0, "y": 40, "w": 12, "h": 8 },
      "datasource": { "type": "postgres", "uid": "pg" },
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 80 },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": { "orientation": "vertical", "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [{
        "rawSql": "SELECT CASE WHEN cvss_base < 1 THEN '0-1' WHEN cvss_base < 4 THEN '1-4' WHEN cvss_base < 7 THEN '4-7' WHEN cvss_base < 9 THEN '7-9' ELSE '9-10' END AS band, COUNT(*) FILTER (WHERE cvss_version = '2.0') AS \"v2.0\", COUNT(*) FILTER (WHERE cvss_version = '3.0') AS \"v3.0\", COUNT(*) FILTER (WHERE cvss_version = '3.1') AS \"v3.1\", COUNT(*) FILTER (WHERE cvss_version = '4.0') AS \"v4.0\" FROM cve_enriched WHERE source = 'NVD' AND cvss_base IS NOT NULL AND vuln_status IS DISTINCT FROM 'Rejected' GROUP BY band ORDER BY band",
        "format": "table"
      }]
    },
    {
      "type": "timeseries",
      "title": "NVD CVEs by Published Date (30d)",
      "description": "Bucketed by NVD published date, falling back to lastModified for rows captured before published was stored. critical = v3/v4 >= 9; v2 scores of 9+ count as high.",
      "gridPos": { "x": 12, "y": 40, "w": 12, "h": 8 },
      "datasource": { "type": "postgres", "uid": "pg" },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "fillOpacity": 60, "stacking": { "mode": "normal" } } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "critical" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "high" }, "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "medium" }, "properties": [{ "id": "color", "value": { "fixedColor": "yellow", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "low" }, "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "rawSql": "SELECT DATE_TRUNC('day', COALESCE(published, modified)) AS time, COUNT(*) FILTER (WHERE cvss_base >= 9 AND cvss_version IS DISTINCT FROM '2.0') AS critical, COUNT(*) FILTER (WHERE cvss_base >= 7 AND (cvss_base < 9 OR cvss_version = '2.0')) AS high, COUNT(*) FILTER (WHERE cvss_base >= 4 AND cvss_base < 7) AS medium, COUNT(*) FILTER (WHERE cvss_base < 4) AS low FROM cve_enriched WHERE source = 'NVD' AND cvss_base IS NOT NULL AND vuln_status IS DISTINCT FROM 'Rejected' AND COALESCE(published, modified) >= NOW() - INTERVAL '30 days' GROUP BY 1 ORDER BY time", "format": "time_series" }
      ]
    },
    {
      "type": "table",
      "title": "Latest Critical CVEs (CVSS v3/v4 >= 9.0, Published Last 30d)",
      "gridPos": { "x": 0, "y": 48, "w": 12, "h": 10 },
      "datasource": { "type": "postgres", "uid": "pg" },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "filterable": true } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "cvss_base" },
            "properties": [
              { "id": "custom.displayMode", "value": "color-background-solid" },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [
                { "color": "orange", "value": null },
                { "color": "red", "value": 9.5 }
              ]}},
              { "id": "decimals", "value": 1 }
            ]
          }
        ]
      },
      "options": { "showHeader": true },
      "targets": [{
        "rawSql": "SELECT cve_id, cvss_base, cvss_version, COALESCE(ssvc_exploitation, '') AS ssvc, COALESCE(published, modified)::date AS published FROM cve_enriched WHERE source = 'NVD' AND cvss_base >= 9.0 AND cvss_version IS DISTINCT FROM '2.0' AND vuln_status IS DISTINCT FROM 'Rejected' AND COALESCE(published, modified) >= NOW() - INTERVAL '30 days' ORDER BY COALESCE(published, modified) DESC, cvss_base DESC LIMIT 30",
        "format": "table"
      }]
    },
    {
      "type": "table",
      "title": "CISA Known Exploited Vulnerabilities (Latest 25)",
      "gridPos": { "x": 12, "y": 48, "w": 12, "h": 10 },
      "datasource": { "type": "postgres", "uid": "pg" },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "filterable": true } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "date_added" },
            "properties": [{ "id": "custom.width", "value": 100 }]
          },
          {
            "matcher": { "id": "byName", "options": "vendor" },
            "properties": [{ "id": "custom.width", "value": 100 }]
          }
        ]
      },
      "options": { "showHeader": true },
      "targets": [{
        "rawSql": "SELECT cve_id, vendor_project AS vendor, product, vulnerability_name AS vulnerability, date_added, known_ransomware_use AS ransomware FROM cve_kev WHERE withdrawn_at IS NULL ORDER BY date_added DESC, cve_id DESC LIMIT 25",
        "format": "table"
      }]
    },

    {
      "type": "row",
      "title": "Feed Intelligence",
      "gridPos": { "x": 0, "y": 58, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Feed Item Volume (7d)",
      "gridPos": { "x": 0, "y": 59, "w": 12, "h": 8 },
      "datasource": { "type": "postgres", "uid": "pg" },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "fillOpacity": 60, "stacking": { "mode": "normal" } } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum"], "sortBy": "Total", "sortDesc": true }, "tooltip": { "mode": "multi" } },
      "targets": [{
        "rawSql": "SELECT DATE_TRUNC('day', inserted_at) AS time, feed_title, COUNT(*) AS items FROM archive WHERE inserted_at >= NOW() - INTERVAL '7 days' AND feed_url LIKE '${feed_source}' GROUP BY time, feed_title ORDER BY time",
        "format": "time_series"
      }]
    },
    {
      "type": "table",
      "title": "Feed Content Coverage",
      "gridPos": { "x": 12, "y": 59, "w": 12, "h": 8 },
      "datasource": { "type": "postgres", "uid": "pg" },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "filterable": true } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "pct_complete" },
            "properties": [
              { "id": "custom.displayMode", "value": "gradient-gauge" },
              { "id": "min", "value": 0 },
              { "id": "max", "value": 100 },
              { "id": "unit", "value": "percent" },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [
                { "color": "red", "value": null },
                { "color": "yellow", "value": 50 },
                { "color": "green", "value": 80 }
              ]}},
              { "id": "decimals", "value": 1 }
            ]
          }
        ]
      },
      "options": { "showHeader": true, "sortBy": [{ "displayName": "pct_complete", "desc": false }] },
      "targets": [{
        "rawSql": "SELECT feed_url AS feed, COUNT(*) AS total, SUM(CASE WHEN (content IS NOT NULL AND content != '') OR (summary IS NOT NULL AND summary != '') THEN 1 ELSE 0 END) AS has_content, ROUND(100.0 * SUM(CASE WHEN (content IS NOT NULL AND content != '') OR (summary IS NOT NULL AND summary != '') THEN 1 ELSE 0 END) / NULLIF(COUNT(*), 0), 1) AS pct_complete FROM current GROUP BY feed_url ORDER BY pct_complete ASC",
        "format": "table"
      }]
    },
    {
      "type": "table",
      "title": "Latest Feed Items (50)",
      "gridPos": { "x": 0, "y": 67, "w": 24, "h": 10 },
      "datasource": { "type": "postgres", "uid": "pg" },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "filterable": true } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "title" },
            "properties": [{ "id": "custom.width", "value": 400 }]
          },
          {
            "matcher": { "id": "byName", "options": "link" },
            "properties": [
              { "id": "links", "value": [{ "title": "Open", "targetBlank": true, "url": "${__data.fields.link}" }] },
              { "id": "custom.width", "value": 80 },
              { "id": "mappings", "value": [{ "type": "regex", "options": { "pattern": ".*", "result": { "text": "Open" } } }] }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "published" },
            "properties": [{ "id": "custom.width", "value": 140 }]
          },
          {
            "matcher": { "id": "byName", "options": "feed" },
            "properties": [{ "id": "custom.width", "value": 200 }]
          }
        ]
      },
      "options": { "showHeader": true },
      "targets": [{
        "rawSql": "SELECT title, link, feed_title AS feed, published, categories FROM current WHERE feed_url LIKE '${feed_source}' ORDER BY inserted_at DESC LIMIT 50",
        "format": "table"
      }]
    },

    {
      "type": "row",
      "title": "Tier-1 Threat-Intel Sources",
      "gridPos": { "x": 0, "y": 77, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "type": "stat",
      "title": "Records by source",
      "gridPos": { "x": 0, "y": 78, "w": 24, "h": 5 },
      "datasource": { "type": "postgres", "uid": "pg" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [{
        "rawSql": "SELECT 'OSV' AS metric, COUNT(*)::float AS value FROM osv_vulns UNION ALL SELECT 'GHSA', COUNT(*) FROM ghsa_advisories UNION ALL SELECT 'URLhaus', COUNT(*) FROM urlhaus_urls UNION ALL SELECT 'ThreatFox', COUNT(*) FROM threatfox_iocs UNION ALL SELECT 'MalwareBazaar', COUNT(*) FROM malwarebazaar_samples UNION ALL SELECT 'Nuclei', COUNT(*) FROM nuclei_templates UNION ALL SELECT 'MSF', COUNT(*) FROM msf_modules",
        "format": "table"
      }]
    },
    {
      "type": "table",
      "title": "ThreatFox — top malware families, last 24h",
      "gridPos": { "x": 0, "y": 83, "w": 12, "h": 10 },
      "datasource": { "type": "postgres", "uid": "pg" },
      "options": { "showHeader": true },
      "targets": [{
        "rawSql": "SELECT malware_printable AS family, COUNT(*) AS iocs_24h, COUNT(*) FILTER (WHERE ioc_type IN ('ip:port','domain')) AS net_iocs, COUNT(*) FILTER (WHERE ioc_type = 'url') AS url_iocs, MAX(first_seen) AS most_recent FROM threatfox_iocs WHERE malware_printable IS NOT NULL AND first_seen > now() - interval '24 hours' GROUP BY malware_printable ORDER BY iocs_24h DESC LIMIT 15",
        "format": "table"
      }]
    },
    {
      "type": "table",
      "title": "MalwareBazaar — most-recent sample signatures",
      "gridPos": { "x": 12, "y": 83, "w": 12, "h": 10 },
      "datasource": { "type": "postgres", "uid": "pg" },
      "options": { "showHeader": true },
      "targets": [{
        "rawSql": "SELECT signature AS family, file_type, COUNT(*) AS samples, MAX(first_seen) AS most_recent FROM malwarebazaar_samples WHERE signature IS NOT NULL GROUP BY signature, file_type ORDER BY samples DESC LIMIT 15",
        "format": "table"
      }]
    },
    {
      "type": "table",
      "title": "Convergence — CVEs covered by ≥3 enrichment sources (last 7d)",
      "gridPos": { "x": 0, "y": 93, "w": 24, "h": 10 },
      "datasource": { "type": "postgres", "uid": "pg" },
      "options": { "showHeader": true },
      "targets": [{
        "rawSql": "SELECT cve AS cve_id, COUNT(DISTINCT a.guid) AS analyses, COUNT(DISTINCT a.source_name) AS sources, MAX(a.severity_level) AS max_sev, (k.cve_id IS NOT NULL) AS in_kev FROM analysis a, jsonb_array_elements_text(a.cve_references) AS cve LEFT JOIN cve_kev k ON k.cve_id = cve WHERE a.inserted_at > now() - interval '7 days' GROUP BY cve, k.cve_id HAVING COUNT(DISTINCT a.source_name) >= 3 ORDER BY sources DESC, analyses DESC LIMIT 15",
        "format": "table"
      }]
    },

    {
      "type": "row",
      "title": "SBOM Coverage",
      "gridPos": { "x": 0, "y": 103, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "type": "stat",
      "title": "SBOM corpus",
      "gridPos": { "x": 0, "y": 104, "w": 12, "h": 5 },
      "datasource": { "type": "postgres", "uid": "pg" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        }
      },
      "options": { "colorMode": "value", "textMode": "value_and_name", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{
        "rawSql": "SELECT 'SBOMs ingested' AS metric, COUNT(*)::float AS value FROM sbom_documents UNION ALL SELECT 'Total packages', COUNT(*)::float FROM sbom_packages UNION ALL SELECT 'Distinct package names', COUNT(DISTINCT name)::float FROM sbom_packages",
        "format": "table"
      }]
    },
    {
      "type": "table",
      "title": "SBOMs ingested",
      "gridPos": { "x": 12, "y": 104, "w": 12, "h": 5 },
      "datasource": { "type": "postgres", "uid": "pg" },
      "options": { "showHeader": true },
      "targets": [{
        "rawSql": "SELECT name AS sbom, vendor, device_type, package_count AS pkgs, ingested_at FROM sbom_documents ORDER BY ingested_at DESC LIMIT 10",
        "format": "table"
      }]
    },
    {
      "type": "table",
      "title": "Top OSV name-match candidates per SBOM (noisy — use /sbom/vulnerabilities for precise list)",
      "gridPos": { "x": 0, "y": 109, "w": 24, "h": 10 },
      "datasource": { "type": "postgres", "uid": "pg" },
      "options": { "showHeader": true },
      "targets": [{
        "rawSql": "SELECT d.device_type AS service, p.name AS package, p.version, COUNT(DISTINCT o.id) AS osv_advisories FROM sbom_packages p JOIN sbom_documents d ON d.id = p.document_id JOIN osv_vulns o ON p.name = ANY(o.package_names) WHERE o.modified > now() - interval '365 days' AND p.version IS NOT NULL AND p.version != '' GROUP BY d.device_type, p.name, p.version ORDER BY osv_advisories DESC LIMIT 15",
        "format": "table"
      }]
    }
  ]
}
